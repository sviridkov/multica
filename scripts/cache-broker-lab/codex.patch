+// Test-only entry point for a broker-launched pinned producer. No model calls.
+use super::*;
+use sha2::Digest;
+use std::io::Write;
+use codex_login::AuthHeaders;
+use std::path::PathBuf;
+use wiremock::{Mock, MockServer, ResponseTemplate};
+use wiremock::matchers::{method, path};
+
+#[tokio::test]
+#[ignore = "requires an isolated broker fixture"]
+async fn produce() {
+    assert_eq!(std::env::var("MULTICA_CACHE_LAB_ALLOW").as_deref(), Ok("1"));
+    let home = PathBuf::from(std::env::var_os("MULTICA_CACHE_LAB_HOME").unwrap());
+    assert!(home.is_absolute());
+    let evidence = match std::env::var("MULTICA_CACHE_LAB_KIND").unwrap().as_str() {
+        "marketplace" => {
+            let oid = std::env::var("MULTICA_CACHE_LAB_OID").unwrap();
+            assert_eq!(oid.len(), 40);
+            assert!(oid.bytes().all(|b| b.is_ascii_hexdigit()));
+            let outcome = crate::marketplace_add::add_marketplace(
+                home.clone(), codex_config::ConfigRequirements::default(),
+                crate::marketplace_add::MarketplaceAddRequest {
+                    source: "https://cache-lab.invalid/fixture.git".to_string(),
+                    ref_name: Some(oid.clone()),
+                    sparse_paths: vec![".agents".to_string(), "plugins".to_string()],
+                },
+            ).await.expect("real marketplace installation/restore must succeed");
+            assert_eq!(outcome.marketplace_name, "cache-lab");
+            let actual = std::process::Command::new("git")
+                .args(["rev-parse", "HEAD"]).current_dir(outcome.installed_root.as_path())
+                .output().unwrap();
+            assert!(actual.status.success());
+            assert_eq!(String::from_utf8(actual.stdout).unwrap().trim(), oid);
+            // Restoration is awaited before the pinned discovery implementation.
+            let config = crate::test_support::load_plugins_config(&home, &home).await;
+            let roots = crate::installed_marketplaces::installed_marketplace_roots_from_layer_stack(
+                &config.config_layer_stack, &home);
+            assert!(roots.iter().any(|p| p == &outcome.installed_root));
+            serde_json::json!({"schema":1,"kind":"marketplace","revision":oid,"endpoint":"https://cache-lab.invalid/fixture.git","scope":"fixture","cache_key":"cache-lab","written":true,"read_verified":true})
+        }
+        "catalog" | "catalog-write-error" => {
+            let fail_write = std::env::var("MULTICA_CACHE_LAB_KIND").unwrap() == "catalog-write-error";
+            let server = MockServer::start().await;
+            let response_body = serde_json::to_string(&serde_json::json!({
+                "plugins": [], "pagination": {"next_page_token": null}
+            })).unwrap();
+            let response_digest = format!("{:x}", sha2::Sha256::digest(response_body.as_bytes()));
+            Mock::given(method("GET")).and(path("/ps/plugins/list"))
+                .respond_with(ResponseTemplate::new(200).set_body_raw(response_body, "application/json"))
+                .expect(1).mount(&server).await;
+            let config = RemotePluginServiceConfig::new(server.uri(),
+                crate::test_support::test_http_client_factory(), None);
+            let auth = CodexAuth::Headers(AuthHeaders::new(http::HeaderMap::new()));
+            let result = fetch_directory_plugins_for_scope_with_cache(Some(&home), &config,
+                &auth, RemotePluginScope::Global, None, RemotePluginCatalogCacheMode::PreferCache)
+                .await.expect("mock transport fetch");
+            assert!(!result.catalog_cache_used);
+            assert_eq!(result.catalog_cache_written, !fail_write);
+            if !fail_write {
+                let cached = fetch_directory_plugins_for_scope_with_cache(Some(&home), &config,
+                    &auth, RemotePluginScope::Global, None, RemotePluginCatalogCacheMode::PreferCache)
+                    .await.expect("read producer-written cache");
+                assert!(cached.catalog_cache_used);
+                assert!(!cached.catalog_cache_written);
+                assert!(home.join("cache/remote_plugin_catalog").read_dir().unwrap().next().is_some());
+            }
+            server.verify().await;
+            let cache_key = if fail_write { String::new() } else {
+                let files = home.join("cache/remote_plugin_catalog").read_dir().unwrap()
+                    .map(|entry| entry.unwrap().file_name().into_string().unwrap()).collect::<Vec<_>>();
+                assert_eq!(files.len(), 1);
+                files[0].clone()
+            };
+            serde_json::json!({"schema":1,"kind":"catalog","revision":response_digest,"endpoint":server.uri(),"scope":"global","cache_key":cache_key,"written":!fail_write,"read_verified":!fail_write})
+        }
+        other => panic!("unsupported fixture operation: {other}"),
+    };
+    if let Some(path) = std::env::var_os("MULTICA_CACHE_LAB_EVIDENCE") {
+        let mut file = std::fs::OpenOptions::new().write(true).create_new(true).open(path).unwrap();
+        file.write_all(&serde_json::to_vec(&evidence).unwrap()).unwrap();
+        file.sync_all().unwrap();
+    }
+}
